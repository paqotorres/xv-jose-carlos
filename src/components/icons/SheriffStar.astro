---
interface Props { class?: string; [key: string]: unknown; }
const { class: cls, ...rest } = Astro.props;
const pts: string[] = [];
const tips: [number, number][] = [];
for (let i = 0; i < 12; i++) {
  const a = (Math.PI / 6) * i - Math.PI / 2;
  const r = i % 2 === 0 ? 42 : 22;
  const x = 50 + r * Math.cos(a);
  const y = 50 + r * Math.sin(a);
  pts.push(`${x.toFixed(2)},${y.toFixed(2)}`);
  if (i % 2 === 0) tips.push([x, y]);
}
---
<svg class={cls} {...rest} viewBox="0 0 100 100" aria-hidden="true">
  <polygon points={pts.join(' ')} fill="currentColor" />
  {tips.map(([x, y]) => <circle cx={x} cy={y} r="5" fill="currentColor" />)}
  <circle cx="50" cy="50" r="13" fill="none" stroke="var(--leather-dark)" stroke-width="2" opacity=".45" />
</svg>
