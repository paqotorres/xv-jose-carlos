---
interface Props { class?: string; [key: string]: unknown; }
const { class: cls, ...rest } = Astro.props;
const holes = [[22, 34], [19, 52], [24, 70], [78, 34], [81, 52], [76, 70]];
---
<svg class={cls} {...rest} viewBox="0 0 100 100" aria-hidden="true">
  <path d="M26 12C12 36 12 68 32 84c10 8 26 8 36 0 20-16 20-48 6-72"
        fill="none" stroke="currentColor" stroke-width="13" stroke-linecap="square" />
  {holes.map(([x, y]) => <circle cx={x} cy={y} r="2.3" fill="var(--leather-dark)" />)}
</svg>
