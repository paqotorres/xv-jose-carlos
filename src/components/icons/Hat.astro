---
interface Props { class?: string; [key: string]: unknown; crown?: string; band?: string; }
const { class: cls, crown = '#b07a45', band = '#3a2416', ...rest } = Astro.props;
---
<svg class={cls} {...rest} viewBox="0 0 200 110" aria-hidden="true">
  <path d="M58 72C54 46 62 16 82 18c10 1 13 12 18 12s8-11 18-12c20-2 28 28 24 54Z" fill={crown} />
  <path d="M100 30c-2 12-1 25 0 34" stroke="rgba(0,0,0,.25)" stroke-width="2.5" fill="none" stroke-linecap="round" />
  <path d="M57 61c28 6 58 6 86 0l-1 11c-27 5-57 5-84 0Z" fill={band} />
  <circle cx="100" cy="68" r="4.5" fill="#e3c88a" />
  <path d="M6 66c8-6 24-2 40 4 20 7 88 7 108 0 16-6 32-10 40-4 4 4-4 18-24 26-24 9-116 9-140 0C10 84 2 70 6 66Z" fill={crown} />
