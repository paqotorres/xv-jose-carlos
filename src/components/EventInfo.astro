---
import SheriffStar from './icons/SheriffStar.astro';
import { EVENT, calendarLinks } from '../data/event';
const icsHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/xv-jose-carlos.ics`;
---
<section id="evento" class="section event">
  <div class="container">
    <h2 class="title" data-reveal>La celebración</h2>

    <article class="card" data-reveal>
      <SheriffStar class="badge" />
      <p class="card-label">Recepción</p>
      <h3 class="venue">{EVENT.venue}</h3>
      <address class="address">
        {EVENT.address.map((line) => <span>{line}</span>)}
      </address>

      <div class="rope"></div>

      <dl class="facts">
        <div>
          <dt>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
            Fecha
          </dt>
          <dd>{EVENT.dateLabel}</dd>
        </div>
        <div>
          <dt>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
            Hora
          </dt>
          <dd>{EVENT.timeLabel}</dd>
        </div>
      </dl>

      <div class="actions">
        <a class="btn btn--primary" href={EVENT.mapsUrl} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
          Ver mapa
        </a>

        <details class="cal">
          <summary class="btn btn--outline">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4M12 13v5M9.5 15.5h5" /></svg>
            Agregar a calendario
          </summary>
          <div class="cal-menu">
            <a href={calendarLinks.google} target="_blank" rel="noopener">Google Calendar</a>
            <a href={icsHref} download="xv-jose-carlos.ics">Apple / iPhone</a>
            <a href={calendarLinks.outlook} target="_blank" rel="noopener">Outlook</a>
          </div>
        </details>
      </div>
    </article>
  </div>
</section>

<script>
  const cal = document.querySelector<HTMLDetailsElement>('.cal');
  document.addEventListener('click', (e) => {
    if (cal?.open && !cal.contains(e.target as Node)) cal.open = false;
  });
  cal?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (cal.open = false)));
</script>

<style>
  .event { padding-top: 24px; }
  .card {
    position: relative;
    margin: 44px auto 0;
    max-width: 560px;
    padding: 52px clamp(20px, 6vw, 48px) 40px;
    background: #fbf4e6 var(--noise);
    border-radius: 16px;
    box-shadow:
      0 0 0 1px rgba(154, 74, 38, .25),
      0 30px 60px -30px rgba(52, 32, 15, .55);
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1.5px dashed rgba(154, 74, 38, .35);
    border-radius: 10px;
    pointer-events: none;
  }
  .badge {
    position: absolute;
    top: -30px;
    left: 50%;
    width: 60px;
    height: 60px;
    transform: translateX(-50%);
    color: var(--gold);
    filter: drop-shadow(0 6px 8px rgba(52, 32, 15, .35));
  }
  .card-label { font-family: var(--font-label); letter-spacing: .35em; text-transform: uppercase; font-size: .78rem; color: var(--ink-soft); margin: 0; }
  .venue { font-family: var(--font-western); font-weight: 400; font-size: clamp(2rem, 8vw, 2.8rem); margin: 6px 0 10px; color: var(--rust-deep); }
  .address { margin: 0 0 22px; font-style: normal; font-size: 1.2rem; line-height: 1.4; color: var(--ink-soft); }
  .address span { display: block; }
  .rope { width: 90px; margin: 0 auto 28px; }

  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 0 0 32px; }
  .facts > div { padding: 16px 8px; border-radius: 10px; background: rgba(231, 212, 177, .45); }
  dt {
    display: flex; align-items: center; justify-content: center; gap: 6px;
    font-family: var(--font-label); font-size: .75rem; letter-spacing: .28em; text-transform: uppercase; color: var(--rust);
  }
  dt svg { width: 16px; height: 16px; }
  dd { margin: 6px 0 0; font-size: 1.22rem; font-weight: 600; line-height: 1.3; }

  .actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .actions > * { flex: 1 1 220px; }
  .actions .btn { width: 100%; }

  .cal { position: relative; }
  .cal summary { list-style: none; }
  .cal summary::-webkit-details-marker { display: none; }
  .cal[open] summary { background: var(--leather); color: var(--paper); }
  .cal-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 8px);
    z-index: 5;
    padding: 6px;
    border-radius: 14px;
    background: var(--leather);
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, .5);
    animation: pop .2s ease;
  }
  @keyframes pop { from { opacity: 0; transform: translateY(-6px); } }
  .cal-menu a {
    display: block;
    padding: 12px;
    border-radius: 10px;
    color: var(--paper);
    text-decoration: none;
    font-family: var(--font-label);
    letter-spacing: .1em;
    font-size: .9rem;
  }
  .cal-menu a:hover, .cal-menu a:focus-visible { background: rgba(201, 164, 92, .2); outline: none; }

  @media (max-width: 420px) {
    .facts { grid-template-columns: 1fr; gap: 10px; }
  }
</style>
