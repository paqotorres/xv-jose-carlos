---
import { EVENT } from '../data/event';
const units = [
  ['days', 'Días'],
  ['hours', 'Horas'],
  ['minutes', 'Minutos'],
  ['seconds', 'Segundos'],
];
---
<div class="countdown" data-target={EVENT.start} role="timer" aria-label="Cuenta regresiva para el evento">
  <div class="grid">
    {units.map(([key, label], i) => (
      <>
        {i > 0 && <span class="sep" aria-hidden="true">:</span>}
        <div class="unit">
          <span class="num" data-unit={key}>00</span>
          <span class="label">{label}</span>
        </div>
      </>
    ))}
  </div>
  <p class="done" hidden>¡Llegó el gran día!</p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.countdown');
  if (root) {
    const target = new Date(root.dataset.target!).getTime();
    const cells = Object.fromEntries(
      [...root.querySelectorAll<HTMLElement>('[data-unit]')].map((el) => [el.dataset.unit, el]),
    );
    const pad = (n: number) => String(n).padStart(2, '0');

    const tick = () => {
      const diff = target - Date.now();
      if (diff <= 0) {
        root.querySelector('.grid')!.setAttribute('hidden', '');
        root.querySelector('.done')!.removeAttribute('hidden');
        clearInterval(timer);
        return;
      }
      const s = Math.floor(diff / 1000);
      cells.days.textContent = pad(Math.floor(s / 86400));
      cells.hours.textContent = pad(Math.floor((s % 86400) / 3600));
      cells.minutes.textContent = pad(Math.floor((s % 3600) / 60));
      cells.seconds.textContent = pad(s % 60);
    };

    const timer = setInterval(tick, 1000);
    tick();
  }
</script>

<style>
  .grid { display: flex; align-items: flex-start; justify-content: center; gap: clamp(4px, 2vw, 14px); }
  .unit {
    position: relative;
    width: clamp(66px, 19vw, 96px);
    padding: 14px 0 10px;
    border-radius: 10px;
    background: linear-gradient(180deg, rgba(243, 231, 209, .1), rgba(243, 231, 209, .03));
    box-shadow: inset 0 0 0 1px rgba(201, 164, 92, .45);
  }
  .unit::after {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px dashed rgba(201, 164, 92, .35);
    border-radius: 6px;
    pointer-events: none;
  }
  .num {
    display: block;
    font-family: var(--font-western);
    font-size: clamp(1.8rem, 7vw, 2.8rem);
    line-height: 1;
    color: var(--gold-light);
    font-variant-numeric: tabular-nums;
  }
  .label {
    display: block;
    margin-top: 8px;
    font-family: var(--font-label);
    font-size: clamp(.58rem, 2vw, .72rem);
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--paper);
    opacity: .8;
  }
  .sep {
    font-family: var(--font-western);
    font-size: clamp(1.4rem, 5vw, 2.2rem);
    color: var(--gold);
    padding-top: 12px;
  }
  .done { font-family: var(--font-western); font-size: 2rem; color: var(--gold-light); margin: 0; }
</style>
