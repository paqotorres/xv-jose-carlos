---
import Envelope from './icons/Envelope.astro';
import SheriffStar from './icons/SheriffStar.astro';
import { EVENT } from '../data/event';
const drops = Array.from({ length: 7 });
---
<section class="section gifts">
  <div class="container">
    <h2 class="title" data-reveal>Regalos</h2>
    <p class="lead intro" data-reveal>
      El regalo más especial para mí es tu presencia, pero si deseas tener un detalle conmigo, tendré:
    </p>

    <div class="rain" data-reveal>
      <div class="drops" aria-hidden="true">
        {drops.map((_, i) => <span style={`--i:${i}`}></span>)}
      </div>
      <Envelope class="envelope" />
      <h3 class="rain-title">Lluvia de sobres</h3>
    </div>

    <div class="or" aria-hidden="true"><span>o</span></div>

    <p class="lead" data-reveal>puedes tener un detalle a través de una transferencia</p>

    <div class="bank" data-reveal>
      <SheriffStar class="bank-star" />
      <span class="bank-label">Número de tarjeta</span>
      <p class="number">{EVENT.transfer.number}</p>
      <p class="holder">{EVENT.transfer.holder}</p>
      <button class="btn btn--gold copy" type="button" data-copy={EVENT.transfer.number.replace(/\s/g, '')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h8" /></svg>
        <span>Copiar número</span>
      </button>
    </div>
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.copy');
  btn?.addEventListener('click', async () => {
    const label = btn.querySelector('span')!;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy!);
      label.textContent = '¡Copiado!';
    } catch {
      label.textContent = btn.dataset.copy!;
    }
    setTimeout(() => (label.textContent = 'Copiar número'), 2200);
  });
</script>

<style>
  .intro { margin-top: 20px; }

  .rain { position: relative; margin: 40px auto 0; max-width: 360px; padding-top: 20px; }
  .envelope { position: relative; z-index: 1; width: min(250px, 70vw); margin: 0 auto; filter: drop-shadow(0 18px 22px rgba(52, 32, 15, .3)); }
  .envelope :global(.envelope__letter) { transition: transform .8s cubic-bezier(.2, .7, .2, 1) .3s; transform: translateY(26px); }
  .rain:global(.is-visible) .envelope :global(.envelope__letter),
  :global(html:not(.js)) .envelope :global(.envelope__letter) { transform: translateY(0); }
  .rain:hover .envelope :global(.envelope__letter) { transform: translateY(-8px); }
  .rain-title { font-family: var(--font-western); font-weight: 400; font-size: clamp(1.7rem, 6vw, 2.2rem); color: var(--rust-deep); margin: 18px 0 0; }

  .drops { position: absolute; inset: -30px 0 40px; overflow: hidden; pointer-events: none; }
  .drops span {
    position: absolute;
    top: -20px;
    left: calc(6% + var(--i) * 13%);
    width: 20px;
    height: 14px;
    border-radius: 2px;
    background: linear-gradient(160deg, transparent 48%, rgba(125, 85, 48, .5) 50%, transparent 52%), linear-gradient(20deg, transparent 48%, rgba(125, 85, 48, .5) 50%, transparent 52%), #d9ae76;
    opacity: 0;
    animation: fall 6s linear infinite;
    animation-delay: calc(var(--i) * -0.85s);
  }
  @keyframes fall {
    0% { transform: translateY(0) rotate(-15deg); opacity: 0; }
    10% { opacity: .75; }
    80% { opacity: .6; }
    100% { transform: translateY(260px) rotate(20deg); opacity: 0; }
  }

  .or { display: flex; align-items: center; gap: 16px; max-width: 260px; margin: 40px auto 20px; color: var(--gold); }
  .or::before, .or::after { content: ''; flex: 1; height: 1px; background: currentColor; }
  .or span { font-family: var(--font-script); font-size: 2.4rem; line-height: 1; color: var(--rust); }

  .bank {
    position: relative;
    max-width: 440px;
    margin: 30px auto 0;
    padding: 34px 24px 28px;
    border-radius: 18px;
    color: var(--paper);
    background:
      radial-gradient(ellipse at 20% 0%, rgba(201, 164, 92, .25), transparent 60%),
      var(--noise),
      linear-gradient(145deg, var(--leather-mid), var(--leather-dark));
    box-shadow: 0 30px 50px -24px rgba(31, 19, 11, .7);
  }
  .bank::before { content: ''; position: absolute; inset: 9px; border: 1.5px dashed rgba(201, 164, 92, .45); border-radius: 12px; pointer-events: none; }
  .bank-star { position: absolute; top: 18px; right: 22px; width: 30px; color: var(--gold); opacity: .8; }
  .bank-label { font-family: var(--font-label); letter-spacing: .3em; text-transform: uppercase; font-size: .72rem; color: var(--gold); }
  .number {
    margin: 10px 0 4px;
    font-family: var(--font-label);
    font-size: clamp(1.45rem, 6.4vw, 1.9rem);
    letter-spacing: .12em;
    color: var(--gold-light);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .holder { margin: 0 0 22px; font-size: 1.2rem; font-style: italic; }
  .copy { position: relative; }
</style>
