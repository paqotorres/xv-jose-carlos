---
import Hat from './icons/Hat.astro';
import Divider from './Divider.astro';
import { EVENT } from '../data/event';
---
<section id="confirmar" class="section section--leather rsvp">
  <div class="container" data-reveal>
    <h2 class="title">Confirmar asistencia</h2>
    <Divider tone="light" />
    <p class="lead">¡Gracias por acompañarme en este día tan importante!</p>
    <p class="lead soft">Favor de confirmar tu asistencia.</p>

    <a class="btn btn--gold wa" href={EVENT.whatsappUrl} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z" /></svg>
      Confirmar ahora
    </a>

    <p class="thanks">¡Muchas gracias!</p>
  </div>
</section>

<footer class="footer">
  <Hat class="f-hat" crown="#9a4a26" band="#1f130b" />
  <p class="f-name">{EVENT.celebrant}</p>
  <p class="f-date">XV · 09 · 10 · 2026</p>
</footer>

<style>
  .soft { opacity: .8; margin-top: 6px; }
  .wa { margin-top: 36px; min-height: 58px; padding: 0 34px; font-size: 1rem; }
  .wa svg { width: 24px; height: 24px; }
  .thanks { font-family: var(--font-script); font-size: clamp(2.4rem, 9vw, 3.2rem); color: var(--gold-light); margin: 40px 0 0; line-height: 1.1; }

  .footer {
    padding: 40px 16px 110px;
    text-align: center;
    color: var(--paper);
    background: var(--leather-dark);
    border-top: 1px solid rgba(201, 164, 92, .2);
  }
  .f-hat { width: 64px; margin: 0 auto 8px; }
  .f-name { font-family: var(--font-western); font-size: 1.4rem; margin: 0; color: var(--gold-light); }
  .f-date { font-family: var(--font-label); letter-spacing: .4em; font-size: .75rem; margin: 6px 0 0; opacity: .7; }
</style>
