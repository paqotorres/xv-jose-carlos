---
import '../styles/global.css';
import { EVENT } from '../data/event';

const title = `Mis XV años · ${EVENT.celebrant}`;
const description = `${EVENT.dateLabel} · ${EVENT.timeLabel} · ${EVENT.venue}. ¡Te espero para celebrar mis XV años!`;
// WhatsApp y Facebook necesitan la URL absoluta de la imagen: define `site` en astro.config.mjs.
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ogImage = Astro.site ? new URL(`${base}og.jpg`, Astro.site).href : `${base}og.jpg`;
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#34200f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_MX" />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mis XV años · José Carlos · Viernes 9 de Octubre 2026" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Oswald:wght@400;500&family=Pinyon+Script&family=Rye&display=swap"
      rel="stylesheet"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
